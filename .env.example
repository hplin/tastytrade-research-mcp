# Never commit real credentials.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=

# Fixed production defaults. Override only for development/testing.
TASTYTRADE_OAUTH_BASE_URL=https://api.tastyworks.com
TASTYTRADE_BACKTESTER_BASE_URL=https://backtester.vast.tastyworks.com
TASTYTRADE_USER_AGENT=tastytrade-research-mcp/0.2.0

# Required only for the remote Streamable HTTP entrypoint.
# Use api-key for local development or oauth for production.
MCP_AUTH_MODE=api-key
MCP_API_KEY=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# Required when MCP_AUTH_MODE=oauth.
MCP_PUBLIC_URL=https://example.azurecontainerapps.io/mcp
OAUTH_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
OAUTH_JWKS_URL=https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys
OAUTH_AUDIENCE=ENTRA_RESOURCE_APP_ID
OAUTH_REQUIRED_SCOPE=api://ENTRA_RESOURCE_APP_ID/mcp.read
OAUTH_TOKEN_SCOPE=mcp.read
OAUTH_RESOURCE_NAME=Tastytrade Research MCP
