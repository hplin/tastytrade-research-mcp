{
  "name": "tastytrade-research-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Research-only MCP server for tastytrade historical data and backtesting.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "handoff:dd-iv": "npm run build --silent && node scripts/generate-dd-iv-handoff.mjs",
    "handoff:dd-iv:check": "npm run build --silent && node scripts/generate-dd-iv-handoff.mjs --check",
    "live:historical-quote-capability": "npm run build --silent && node --env-file-if-exists=.env scripts/live-historical-quote-capability.mjs",
    "live:resolution-gate": "npm run build --silent && node --env-file-if-exists=.env scripts/live-resolution-profile-gate.mjs",
    "report:evidence-cache": "npm run build --silent && node scripts/evidence-cache-report.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.1",
    "axios": "^1.17.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0"
  }
}
